# Optional for SQLite development: the defaults work without copying this file.
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
# Set a unique secret before exposing the application beyond local development.
# SECRET_KEY=replace-with-a-random-secret
# Leave DATABASE_URL unset for local db.sqlite3.
# With the optional compose.yaml development database:
# DATABASE_URL=postgresql://rights:local-development-only@127.0.0.1:5433/rights
OPTION_FILES=true
# MEDIA_ROOT can be an absolute machine-specific path; defaults to ./media.
# Publisher identity is only needed when configuring actual DMP registration.
# PUBLISHER=Your publishing company
# PUBLISHER_CODE=000
# PUBLISHER_IPI_NAME=
# Valgfri fysisk NAS-root. Databasen lagrer bare relative, portable stier.
P7_NAS_ROOT=
P7_MUSIC_ROOT=

# GUI v2 is read-only by default. The dedicated test launcher enables writes
# only while using .local/gui-v2-test.sqlite3 and .local/gui-v2-files.
GUI_V2_WRITES_ENABLED=false
